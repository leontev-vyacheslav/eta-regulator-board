{
   "version": "2.0.0",
   "tasks": [
      {
         "type": "npm",
         "script": "start",
         "path": "web-ui",
         "isBackground": true,
         "problemMatcher": {
            "owner": "custom",
            "pattern": {
               "regexp": "^$"
            },
            "background": {
               "activeOnStart": true,
               "beginsPattern": "Compiling...",
               "endsPattern": "Compiled .*"
            }
         }
      },
      {
         "type": "shell",
         "label": "omega-wifi",
         "command": [
            "echo '${input:WIFI-HOSTS-ENTRY}' | sudo tee -a '/etc/hosts' > /dev/null"
         ],
         "isBackground": true,
         "presentation": {
            "reveal": "silent",
            "revealProblems": "onProblem",
            "close": true
         },
         "problemMatcher": []
      },
   ],
   "inputs": [
      {
         "id": "WIFI-HOSTS-ENTRY",
         "type": "pickString",
         "description": "Omega device IP",
         "options": ["192.168.0.100    heatbox-8f79", "192.168.0.101    heatbox-7e12", "192.168.0.102    heatbox-7542"],
         "default": ""
      }
   ],
}